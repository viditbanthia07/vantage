.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Local artifacts
data/
samples/
snapshots/
*.mp4
*.avi
*.mkv
logs/
*.log

# Models (added from Phase 2 onward; never commit weights)
models/
*.onnx
*.pt
*.xml
*.bin

# Stores written by 'vantage run --store'. The default path is vantage.db in
# the working directory, so without this a user who enables storage finds a
# database - potentially containing footage-derived observations - staged for
# their next commit.
*.db
*.db-wal
*.db-shm

# Build outputs
dist/
build/
*.spec.bak

# Front-end dependencies. The built bundle in
# src/vantage/dashboard/static IS committed - the dashboard server reads it
# from disk and the packaged exe bundles it - but its inputs are not.
frontend/node_modules/
frontend/dist/

# Marketing site (site/). Its dependencies and build output are not committed;
# its captured media and captured API payloads are, because they are the page's
# content and regenerating them needs the sample clips and a real run.
site/node_modules/
site/dist/

# ...and the H.264 fallback for the hero clip, which the blanket *.mp4 rule
# above would otherwise drop, leaving Safari before 14.1 with a poster frame
# and no video.
!site/public/media/*.mp4
